# ==============================================================================
# NetSentinel - Defensive .gitignore
# ==============================================================================

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Secrets and environment files
.env
.env.local
.env.*.local
!.env.example

# Datasets and raw network captures
data/*
!data/README.md
!data/.gitkeep

# Machine Learning models and artifacts
models/*
!models/README.md
!models/.gitkeep
!models/unsw_nb15_model.onnx
!models/unsw_nb15_model.json

# SQLite and persistent database files
*.db
*.sqlite
*.sqlite3

# Test caches and coverage reports
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and OS generated files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Logs and runtime exports
*.log
logs/
exports/
reports/
outputs/

# Build & packaging
build/
dist/
*.egg-info/
