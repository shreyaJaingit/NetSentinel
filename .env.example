# ==============================================================================
# NetSentinel - Environment Configuration Template
# COPY THIS FILE TO .env AND ADAPT FOR YOUR LOCAL ENVIRONMENT.
# NEVER COMMIT REAL SECRETS, API KEYS, OR PRIVATE CREDENTIALS TO GIT.
# ==============================================================================

# Application Environment (development, testing, production)
NETSENTINEL_ENV=development

# Database Settings
# Local SQLite database path (kept out of git via .gitignore)
DATABASE_URL=sqlite:///./netsentinel.db

# API Service Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Upload Security Limits
# Maximum permitted CSV upload size in megabytes to prevent Denial of Service (DoS)
MAX_UPLOAD_SIZE_MB=10

# Detection & Alert Thresholds
# Minimum probability (0.0 to 1.0) required to flag a record as suspicious/alert
ALERT_CONFIDENCE_THRESHOLD=0.50

# Model Paths
MODEL_ARTIFACT_PATH=./models/baseline_model.joblib
PREPROCESSOR_ARTIFACT_PATH=./models/preprocessor.joblib
